{
  "name": "crate",
  "version": "1.14.0",
  "private": true,
  "description": "Windows desktop music manager and car sync engine for MP3/FLAC collections",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "node dev-runner.js",
    "dev:web": "vite",
    "start": "electron .",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "npm run build && npm run build:electron && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:intent": "csd-intent ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.475.0",
    "music-metadata": "^11.16.1",
    "node-id3": "^0.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
